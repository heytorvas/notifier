{
  "expo": {
    "name": "Notifier",
    "slug": "notifier",
    "version": "1.4.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "scheme": "notifier",
    "android": {
      "backgroundColor": "#000000",
      "package": "dev.heytor.notifier",
      "versionCode": 7,
      "allowBackup": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Notifier to scan a pairing QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true,
            "gifEnabled": false,
            "extraProguardRules": "-keep class expo.modules.notifiernative.NotifierNativeModule { *; } -keep class expo.modules.notifiernative.notifications.** extends android.app.Service { *; } -keep class expo.modules.notifiernative.notifications.** extends android.content.ContentProvider { *; } -keep class expo.modules.notifiernative.notifications.** extends androidx.work.ListenableWorker { *; }"
          }
        }
      ]
    ],
    "platforms": [
      "android",
      "web"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "owner": "your-expo-account"
  }
}
